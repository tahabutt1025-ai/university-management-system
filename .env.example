# ===========================
# Server Configuration
# ===========================
PORT=5000
NODE_ENV=production

# ===========================
# MongoDB Atlas Connection
# Get this from: https://cloud.mongodb.com
# Format: mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbname>
# ===========================
MONGO_URI=mongodb+srv://your_username:your_password@cluster0.xxxxx.mongodb.net/university_management

# ===========================
# JWT Secret (change this to a long random string!)
# Generate one: https://www.uuidgenerator.net/
# ===========================
JWT_SECRET=change_this_to_a_very_long_random_secret_string_min_32_chars
JWT_EXPIRE=7d

# ===========================
# Client URL (your Vercel frontend URL after deploy)
# ===========================
CLIENT_URL=https://your-project-name.vercel.app

# ===========================
# Email (optional - for password reset)
# ===========================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# ===========================
# OpenAI API (optional - for AI insights)
# Get from: https://platform.openai.com/api-keys
# ===========================
OPENAI_API_KEY=sk-your_openai_api_key_here
